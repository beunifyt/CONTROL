rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// BeUnifyT — Reglas de seguridad de Firestore
//
// IMPORTANTE: este archivo NO hace nada por sí solo. Hay que
// PUBLICARLO en Firebase Console → Firestore Database → Reglas →
// pegar este contenido → botón "Publicar".
//
// Correcciones incluidas:
//  - A-RULES.1: fallback a permisos por defecto si config/permisos
//    no existe (antes esto bloqueaba a todos los no-admin).
//  - canCreate/Edit/Delete nunca revientan aunque el doc de permisos
//    o el rol falten.
//  - referencias/ingresos: matricula puede venir vacía (import Excel
//    antes de asignar matrícula) y posicion es opcional.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de autenticación ─────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() {
      return userExists() && userDoc().active == true;
    }
    function userRole() {
      return userExists() ? userDoc().role : '';
    }
    function isAdmin() {
      return isActiveUser() && userRole() == 'admin';
    }
    function isSupervisor() {
      return isActiveUser() && (userRole() == 'admin' || userRole() == 'supervisor');
    }

    // ── Permisos por rol — con fallback (A-RULES.1) ───────────
    // Si config/permisos NO existe (primer arranque), se usan
    // defaults razonables en lugar de bloquear todo.
    function permsExists() {
      return exists(/databases/$(database)/documents/config/permisos);
    }
    function permsDoc() {
      return get(/databases/$(database)/documents/config/permisos).data;
    }
    function defaultCanCreate(role) {
      return role == 'supervisor' || role == 'operario';
    }
    function defaultCanEdit(role) {
      return role == 'supervisor' || role == 'operario';
    }
    function defaultCanDelete(role) {
      return role == 'supervisor';
    }
    function getCanCreate(role) {
      return permsExists() && permsDoc()[role] != null
        ? permsDoc()[role].canCreate == true
        : defaultCanCreate(role);
    }
    function getCanEdit(role) {
      return permsExists() && permsDoc()[role] != null
        ? permsDoc()[role].canEdit == true
        : defaultCanEdit(role);
    }
    function getCanDelete(role) {
      return permsExists() && permsDoc()[role] != null
        ? permsDoc()[role].canDelete == true
        : defaultCanDelete(role);
    }
    function canCreate() {
      return isAdmin() || (isActiveUser() && getCanCreate(userRole()));
    }
    function canEdit() {
      return isAdmin() || (isActiveUser() && getCanEdit(userRole()));
    }
    function canDelete() {
      return isAdmin() || (isActiveUser() && getCanDelete(userRole()));
    }

    // ── users/{uid} ──────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    // ── config/{docId} (permisos por rol) ────────────────────
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── invites/{code} ──────────────────────────────────────
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.used == true
                        && request.resource.data.usedByUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── recintos / eventos / empresas / conductores / flota ──
    match /recintos/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }
    match /eventos/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
      match /templates/{tplId} {
        allow read:   if isActiveUser();
        allow create: if canCreate();
        allow update: if canEdit();
        allow delete: if canDelete();
      }
    }
    match /empresas/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }
    match /conductores/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }
    match /flota/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── referencias ─────────────────────────────────────────
    // matricula: string pero PUEDE estar vacía (import de Excel
    // antes de asignar matrícula). posicion: opcional.
    match /referencias/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate()
                    && request.resource.data.eventoId is string
                    && request.resource.data.eventoId.size() > 0
                    && (!('matricula' in request.resource.data)
                        || request.resource.data.matricula is string)
                    && (!('posicion' in request.resource.data)
                        || request.resource.data.posicion is number);
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── ingresos ────────────────────────────────────────────
    match /ingresos/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate()
                    && request.resource.data.eventoId is string
                    && request.resource.data.eventoId.size() > 0
                    && (!('matricula' in request.resource.data)
                        || request.resource.data.matricula is string)
                    && (!('posicion' in request.resource.data)
                        || request.resource.data.posicion is number);
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── agenda ──────────────────────────────────────────────
    match /agenda/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── mensajes ────────────────────────────────────────────
    match /mensajes/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── counters (posiciones automáticas) ───────────────────
    match /counters/{counterId} {
      allow read:  if isActiveUser();
      allow write: if isActiveUser();
    }

    // ── plantillas ──────────────────────────────────────────
    match /templates_global/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── auditoría ───────────────────────────────────────────
    match /audit/{id} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /audit_exports/{id} {
      allow read:   if isAdmin();
      allow create: if isActiveUser();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /incidencias/{id} {
      allow read:   if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isSupervisor();
      allow delete: if isAdmin();
    }

    // ── dispositivos (security.js) ──────────────────────────
    match /devices/{id} {
      allow read:   if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── preregistros (portal B2B) ───────────────────────────
    match /preregistros/{id} {
      allow read:   if isSupervisor();
      allow create: if true;
      allow update: if isSupervisor();
      allow delete: if isSupervisor();
    }

    // ── listas (blacklist, lista espera) ────────────────────
    match /listas/{id} {
      allow read:   if isActiveUser();
      allow create: if canCreate();
      allow update: if canEdit();
      allow delete: if canDelete();
    }

    // ── turnos ──────────────────────────────────────────────
    match /turnos/{id} {
      allow read:   if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser();
      allow delete: if isAdmin();
    }

    // ── chats con asistentes IA ─────────────────────────────
    match /asistente_chats/{id} {
      allow read:   if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

  }
}
